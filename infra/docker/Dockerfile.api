# MetriCheck AI — API Gateway Dockerfile
FROM node:20-alpine AS builder

WORKDIR /app

# Install build essentials
RUN apk add --no-cache python3 make g++

# Copy root workspace configs
COPY package.json package-lock.json* tsconfig.json* ./

# Copy packages and api app
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/

# Install dependencies for the monorepo
RUN npm install

# Build shared packages and api
RUN npm run build:types
RUN npm run build:rules
RUN npm run build --workspace=apps/api

# --- Runner Stage ---
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

# Copy root package manifests and installed node_modules
COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/api ./apps/api

# Create storage directory
RUN mkdir -p /app/apps/api/storage/uploads

EXPOSE 4000

CMD ["node", "apps/api/dist/index.js"]
