# MetriCheck AI — Frontend Web PWA Dockerfile
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root workspace configs
COPY package.json package-lock.json* tsconfig.json* ./

# Copy packages and web app
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/

# Install dependencies
RUN npm install

# Build shared packages and Vite Web bundle
RUN npm run build:types
RUN npm run build:rules
RUN npm run build --workspace=apps/web

# --- Runner Stage (Nginx Alpine) ---
FROM nginx:alpine AS runner

# Remove default nginx html
RUN rm -rf /usr/share/nginx/html/*

# Copy built SPA bundle
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Copy Nginx SPA and PWA configuration
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
